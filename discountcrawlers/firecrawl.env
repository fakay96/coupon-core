# Firecrawl API Configuration
FIRECRAWL_API_KEY=fc-072741aa600f4082aa21c2c8a773dfed

# Firecrawl Settings
FIRECRAWL_TIMEOUT=30
FIRECRAWL_MAX_RETRIES=3
FIRECRAWL_RETRY_DELAY=1.0
FIRECRAWL_MAX_CONCURRENT=10

# Feature flags
FIRECRAWL_ENABLE_SCREENSHOTS=false
FIRECRAWL_ENABLE_PDF=false

# Wait settings
FIRECRAWL_WAIT_TIMEOUT=5000
FIRECRAWL_WAIT_SELECTORS=.product-title,.price,.product-price

# Fallback settings
FIRECRAWL_FALLBACK_TO_TRADITIONAL=true
FIRECRAWL_LOG_FAILURES=true

# Performance settings
FIRECRAWL_BATCH_SIZE=10
FIRECRAWL_CONCURRENT_BATCHES=2 