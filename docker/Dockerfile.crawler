FROM python:3.11-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev && rm -rf /var/lib/apt/lists/*
COPY discountcrawlers/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim
WORKDIR /app
RUN mkdir -p /app/discountcrawlers/{spiders,middlewares,pipelines,utils} /app/logs
COPY --from=builder /install /usr/local
COPY discountcrawlers/discountcrawlers/ /app/discountcrawlers/
ENV PYTHONPATH=/app
ENV SCRAPY_SETTINGS_MODULE=discountcrawlers.settings
CMD ["scrapy", "crawl", "penny", "-a", "mode=job"]
