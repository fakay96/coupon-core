FROM python:3.11-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc python3-dev && rm -rf /var/lib/apt/lists/*
COPY discountcrawlers/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim
WORKDIR /app
RUN mkdir -p /app/discountcrawlers/{agents,config} /app/logs
COPY --from=builder /install /usr/local
COPY discountcrawlers/discountcrawlers/__init__.py           /app/discountcrawlers/
COPY discountcrawlers/discountcrawlers/settings.py            /app/discountcrawlers/
COPY discountcrawlers/discountcrawlers/config/                /app/discountcrawlers/config/
COPY discountcrawlers/discountcrawlers/agents/                /app/discountcrawlers/agents/
ENV PYTHONPATH=/app
ENV DJANGO_SETTINGS_MODULE=discountcrawlers.settings
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV REDIS_DB=0
CMD ["python", "-m", "discountcrawlers.agents.coordinator_agent"]
